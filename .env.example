# ---------------------------------------------------------------------------
# PDFForge environment — EXAMPLE values only. Copy to .env and edit.
# NEVER put real secrets in this file or commit a real .env.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
APP_ENV=development                 # development | production
APP_DEBUG=false                     # keep false; true may expose more detail in logs only

# Comma-separated list of allowed browser origins (the frontend).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Upload / processing limits (defense-in-depth)
MAX_UPLOAD_BYTES=52428800           # 50 MB total request body cap
MAX_FILE_BYTES=26214400             # 25 MB per single file
MAX_FILES_PER_REQUEST=20            # max files in one multi-file request
MAX_PDF_PAGES=500                   # reject PDFs with more pages than this
MAX_IMAGE_PIXELS=40000000           # ~40 MP guard against decompression bombs

# Per-operation hard timeout (seconds)
OP_TIMEOUT_SECONDS=30
# Office conversions (PDF<->Word) hard timeout (seconds)
OFFICE_TIMEOUT_SECONDS=120

# Temp storage + retention
DATA_DIR=.data                      # where temp inputs/outputs live (gitignored)
RETENTION_SECONDS=900               # auto-delete processed files after 15 minutes
DOWNLOAD_TOKEN_TTL_SECONDS=900      # download links expire after 15 minutes

# Rate limiting (per client IP)
RATE_LIMIT_REQUESTS=30              # requests allowed...
RATE_LIMIT_WINDOW_SECONDS=60        # ...per this many seconds
# Set true ONLY when behind a proxy/load-balancer you control, so the real client IP
# is read from X-Forwarded-For. Leave false on a directly-exposed server (anti-spoof).
TRUST_FORWARDED_FOR=false

# --- Frontend --------------------------------------------------------------
# (frontend uses its own .env.local — see frontend/.env.local.example)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
